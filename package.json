{
  "name": "@stackline/should",
  "description": "test framework agnostic BDD-style assertions",
  "version": "1.0.0",
  "author": "TJ Holowaychuk <tj@vision-media.ca>, Denis Bardadym <bardadymchik@gmail.com>",
  "typings": "./should.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-should.git"
  },
  "homepage": "https://github.com/alexandroit/stackline-should#readme",
  "scripts": {
    "build": "rollup lib/index.js --format cjs --file cjs/should.js && rollup lib/index.js --format es --file es6/should.js && rollup lib/should.js --format cjs --file as-function.js && rollup -c rollup.config.js --input lib/umd.js --format iife --file should.js && node scripts/normalize-build.mjs",
    "test": "mocha --require ./cjs/should test/*.test.js test/**/*.test.js && node test/stackline.cjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "rollup": "4.63.5",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-commonjs": "29.0.3",
    "mocha": "12.0.2",
    "bluebird": "3.7.2"
  },
  "keywords": [
    "test",
    "bdd",
    "assert",
    "should",
    "stackline",
    "maintenance-fork"
  ],
  "main": "./cjs/should.js",
  "module": "./es6/should.js",
  "license": "MIT",
  "dependencies": {
    "should-equal": "^2.0.0",
    "should-format": "^3.0.3",
    "should-type": "^1.4.0",
    "should-type-adaptors": "^1.0.1",
    "should-util": "^1.0.0"
  },
  "files": [
    "cjs/*",
    "es6/*",
    "as-function.js",
    "should.js",
    "LICENSE",
    "*.md",
    "should.d.ts",
    "LICENSE*",
    "license*",
    "NOTICE",
    "UPSTREAM.md",
    "CHANGELOG.md",
    "README.md",
    "readme.md"
  ],
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-should/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
